# Variables de entorno del backend: Legado&Origen
# Copia este archivo como ".env" y ajusta los valores. El archivo .env no se sube al repositorio.

PORT=3000

# PostgreSQL (valores del contenedor de docker-compose.yml)
DB_HOST=localhost
DB_PORT=5433
DB_NAME=legado_origen
DB_USER=postgres
DB_PASSWORD=postgres

# Duración de la reserva de una pieza, en minutos (HU-08)
RESERVATION_MINUTES=15